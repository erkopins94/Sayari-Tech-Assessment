# Credentials — never bake secrets into the image
.env
sayari_api_keys.json

# Git history is not needed inside the container
.git/
.gitignore

# Python bytecode and virtual environments
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Streamlit secrets (handled via env_file in docker-compose instead)
.streamlit/

# Generated output files
output/

# Development/IDE artifacts
.pytest_cache/
*.egg-info/
